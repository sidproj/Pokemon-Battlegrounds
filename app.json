{
  "expo": {
    "name": "pokeDex",
    "slug": "pokeDex",
    "scheme": "pokeDex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokeball.png",
    "splash": {
      "image": "./assets/images/pokeball.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
